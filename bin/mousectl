#!/usr/bin/env bash
# mousectl launcher. Zero dependencies: runs with the system Python 3 straight
# from the repo. install.sh symlinks it into ~/.local/bin as `mousectl`.
set -euo pipefail

ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
PY="${PYTHON:-python3}"
if ! command -v "$PY" >/dev/null 2>&1; then
    echo "mousectl: '$PY' not found - install Python 3.9+ first" >&2
    exit 1
fi

export PYTHONPATH="$ROOT${PYTHONPATH:+:$PYTHONPATH}"
exec "$PY" -m mousectl "$@"
